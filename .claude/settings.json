{
  "projectName": "Cindar's Hope",
  "description": "2D pixel art RPG + farm sim in Unity. Agent operations for spec execution, validation, and documentation.",

  "permissions": {
    "bash": {
      "default": "allow",
      "blocked": [
        "git push",
        "git reset --hard",
        "git clean",
        "git stash",
        "rm -rf",
        "del /s /q",
        "Remove-Item -Recurse -Force"
      ]
    },
    "powerShell": {
      "default": "allow",
      "blocked": [
        "git push",
        "git reset --hard",
        "git clean",
        "git stash",
        "Remove-Item.*Recurse.*Force",
        "Clear-Content"
      ]
    }
  },

  "allowedTools": {
    "read": true,
    "glob": true,
    "grep": true,
    "edit": true,
    "write": true,
    "bash": true,
    "powerShell": true,
    "todovrite": true,
    "agent": true,
    "skill": true,
    "ask": true
  },

  "safeCommands": {
    "git": [
      "git status",
      "git diff",
      "git log --oneline -20",
      "git branch",
      "git add",
      "git commit -m"
    ],
    "validation": [
      "tools/docs/validate_docs.ps1",
      "tools/unity/RunUnityCompileValidation.ps1",
      "tools/unity/ScanUnityLogs.ps1"
    ]
  },

  "hooks": {
    "preBashGuard": {
      "enabled": true,
      "path": ".claude/hooks/pre-bash-guard.ps1",
      "description": "Block unsafe git and file operations"
    },
    "postEditDocsValidate": {
      "enabled": false,
      "path": ".claude/hooks/post-edit-docs-validate.ps1",
      "description": "Remind about doc validation after edits (non-blocking)"
    },
    "stopSummaryCheck": {
      "enabled": true,
      "path": ".claude/hooks/stop-summary-check.ps1",
      "description": "Remind about closeout checklist on task completion"
    }
  },

  "documentation": {
    "sourceOfTruth": "docs/specs/",
    "implementationStatus": "docs/IMPLEMENTATION_STATUS.md",
    "projectLog": "PROJECT_LOG.md",
    "operationalProtocol": "docs/operations/AGENT_EXECUTION_PROTOCOL.md"
  },

  "validation": {
    "docsValidationScript": "tools/docs/validate_docs.ps1",
    "unityCompileScript": "tools/unity/RunUnityCompileValidation.ps1",
    "unityLogScannerScript": "tools/unity/ScanUnityLogs.ps1"
  },

  "rules": {
    "noRootSpecs": true,
    "noDocOldEdits": true,
    "requireEvidenceForStatus": true,
    "requireValidationBeforeCloseout": true,
    "forbiddenNamespaces": [
      "CindarsHope.Debug",
      "CindarsHope.Temp"
    ]
  },

  "localOverrides": {
    "enabled": true,
    "path": ".claude/settings.local.json",
    "description": "Machine-specific settings (ignored by git)"
  }
}
