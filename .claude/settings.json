{
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(rm -rf:*)",
      "PowerShell(git push:*)",
      "PowerShell(git reset:*)",
      "PowerShell(git clean:*)",
      "PowerShell(git stash:*)",
      "PowerShell(git rebase:*)",
      "PowerShell(git branch -D:*)",
      "PowerShell(git checkout --:*)",
      "PowerShell(git restore:*)",
      "Edit(**/*.unity)",
      "Edit(**/*.prefab)",
      "Edit(**/*.asset)",
      "Write(**/*.unity)",
      "Write(**/*.prefab)",
      "Write(**/*.asset)",
      "Edit(Packages/**)",
      "Write(Packages/**)",
      "Edit(ProjectSettings/**)",
      "Write(ProjectSettings/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/pre-bash-guard.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/protected-path-guard.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/runtime-code-guard.ps1"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/detect-change-scope.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/stop-summary-check.ps1"
          }
        ]
      }
    ]
  }
}
