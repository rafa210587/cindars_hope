{
  "projectName": "Cindar's Hope",
  "description": "2D pixel art RPG + farm sim in Unity. Agent operations for spec execution, validation, and documentation.",

  "permissions": {
    "bash": {
      "default": "allow",
      "blocked": [
        "git push",
        "git reset --hard",
        "git clean",
        "git stash",
        "rm -rf",
        "del /s /q",
        "Remove-Item -Recurse -Force"
      ]
    },
    "powerShell": {
      "default": "allow",
      "blocked": [
        "git push",
        "git reset --hard",
        "git clean",
        "git stash",
        "Remove-Item.*Recurse.*Force",
        "Clear-Content"
      ]
    }
  },

  "allowedTools": {
    "read": true,
    "glob": true,
    "grep": true,
    "edit": true,
    "write": true,
    "bash": true,
    "powerShell": true,
    "todovrite": true,
    "agent": true,
    "skill": true,
    "ask": true
  },

  "safeCommands": {
    "git": [
      "git status",
      "git diff",
      "git log --oneline -20",
      "git branch",
      "git add",
      "git commit -m"
    ],
    "validation": [
      "tools/docs/validate_docs.ps1",
      "tools/unity/RunUnityCompileValidation.ps1",
      "tools/unity/ScanUnityLogs.ps1"
    ]
  },

  "hooks": {
    "preBashGuard": {
      "enabled": true,
      "path": ".claude/hooks/pre-bash-guard.ps1",
      "description": "Block unsafe git and file operations",
      "trigger": "pre-bash"
    },
    "detectChangeScope": {
      "enabled": true,
      "path": ".claude/hooks/detect-change-scope.ps1",
      "description": "Detect type of changes and save scope to .claude/.runtime/change-scope.json",
      "trigger": "post-edit"
    },
    "postEditDocsValidate": {
      "enabled": false,
      "path": ".claude/hooks/post-edit-docs-validate.ps1",
      "description": "Remind about doc validation after edits (non-blocking)",
      "trigger": "post-edit"
    },
    "stopSummaryCheck": {
      "enabled": true,
      "path": ".claude/hooks/stop-summary-check.ps1",
      "description": "Intelligent checklist based on change scope",
      "trigger": "stop"
    },
    "runRequiredValidations": {
      "enabled": false,
      "path": ".claude/hooks/run-required-validations.ps1",
      "description": "Run validations based on detected change scope (manual trigger via /implement-spec)",
      "trigger": "manual"
    },
    "checkCsprojIncludes": {
      "enabled": false,
      "path": ".claude/hooks/check-csproj-includes.ps1",
      "description": "Warn when changed C# files are missing from local Unity csproj files",
      "trigger": "manual"
    },
    "checkRuntimeForbiddenSearch": {
      "enabled": false,
      "path": ".claude/hooks/check-runtime-forbidden-search.ps1",
      "description": "Warn or fail on prohibited runtime scene search APIs",
      "trigger": "manual"
    },
    "checkCaveStableRunScope": {
      "enabled": false,
      "path": ".claude/hooks/check-cave-stable-run-scope.ps1",
      "description": "Warn when cave runtime/procedural changes require FASE9F stable-run guardrails",
      "trigger": "manual"
    }
  },

  "documentation": {
    "sourceOfTruth": "docs/specs/",
    "implementationStatus": "docs/IMPLEMENTATION_STATUS.md",
    "projectLog": "PROJECT_LOG.md",
    "operationalProtocol": "docs/operations/AGENT_EXECUTION_PROTOCOL.md"
  },

  "validation": {
    "docsValidationScript": "tools/docs/validate_docs.ps1",
    "unityCompileScript": "tools/unity/RunUnityCompileValidation.ps1",
    "unityLogScannerScript": "tools/unity/ScanUnityLogs.ps1"
  },

  "rules": {
    "ruleIndex": ".claude/rules/RULES.md",
    "noRootSpecs": true,
    "noDocOldEdits": true,
    "noRuntimeGlobalSearch": true,
    "saveDtoSimpleTypesOnly": true,
    "caveStableRun": true,
    "unityValidationHonesty": true,
    "generatedAssetEvidence": true,
    "noParallelUnityBatchmode": true,
    "requireEvidenceForStatus": true,
    "requireValidationBeforeCloseout": true,
    "forbiddenNamespaces": [
      "CindarsHope.Debug",
      "CindarsHope.Temp"
    ]
  },

  "localOverrides": {
    "enabled": true,
    "path": ".claude/settings.local.json",
    "description": "Machine-specific settings (ignored by git)"
  }
}
