# Cindar's Hope — Unity .gitignore

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Unity cache / crash reports
.sysinfo.txt
*.stackdump
crashlytics-build.properties

# Unity autogenerated project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider / JetBrains
.idea/
*.sln.iml

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Visual Studio
.vs/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Local save/dev runtime output
[Ss]aves/
AppData/
*.log

# SpecKit temporary/cache output
.specify/cache/

# Local environment files
.env
.env.*
